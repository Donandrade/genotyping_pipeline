params {
    // Pastas e Arquivos de Entrada
    outdir         = "./output"
    samples        = "sample_1.tsv"
    ref            = "reference/subgenome_blue.multi.fa"

    // Configuração de Alvos/Regiões
    probes         = "probes.bed"
    regions        = "regions.txt"
    multiqc_config = "multiqc_config.yaml"
}

// Configuração do Executor para suportar alta carga de amostras
executor {
    name            = 'slurm'
    queueSize       = 100       // Permite até 2000 jobs simultâneos
    submitRateLimit = '10 sec'    // Evita sobrecarga no escalonador do HPC
}

process {
    executor       = 'slurm'
    clusterOptions = '--account=munoz --qos=munoz-b'
    beforeScript   = 'module purge'

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // 1. TRIMAGEM
    withName: TRIM {
        module = 'trimmomatic/0.39'
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1h'
    }

    // 2. ALINHAMENTO
    withName: ALIGN {
        module = 'bwa/0.7.17:samtools/1.20'
        cpus   = 2
        memory = { 5.GB * task.attempt }
        time   = '12h'
    }

    // 3. PILEUP INDIVIDUAL
    withName: INDIVIDUAL_CALL {
        module = 'bcftools/1.22'
        cpus   = 2
        memory = { params.probes ? 10.GB * task.attempt : 8.GB * task.attempt }
        time   = { params.probes ? '20h' : '4h' }
    }

    // 4. JOINT CALLING
    withName: MERGE_AND_CALL {
        module = 'bcftools/1.22'
        cpus   = 2
        memory = { 30.GB * task.attempt }
        time   = '12h'
    }

    // 5. CONTROLE DE QUALIDADE (Separados para evitar erro de null)
    withName: QC_BAM {
        module = 'samtools/1.20'
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: COVERAGE_QC {
        module = 'mosdepth/0.3.1'
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    // 6. RELATÓRIO FINAL
    withName: MULTIQC {
        module = 'multiqc/1.28'
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,rss,vmem'
}

report {
    enabled = true
    file    = "${params.outdir}/execution_report.html"
}

cleanup = true
