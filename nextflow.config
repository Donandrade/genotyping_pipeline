params {
    // Pastas e Arquivos de Entrada
    outdir        = "./output"
    samples       = "sample_1.tsv"
    ref           = "reference/subgenome_blue.multi.fa"
    
    // Configuração de Alvos/Regiões
    // Para usar regions.txt, mantenha probes = false
    // Para usar probes, coloque o caminho do arquivo aqui
    probes        = "probes.bed" 
    regions       = "regions.txt" 
    
    multiqc_config = "multiqc_config.yaml"
}


process {
    executor       = 'slurm'
    clusterOptions = '--account=munoz --qos=munoz-b'
    beforeScript   = 'module purge'
    
    // Estratégia de erro: tenta novamente se falhar por falta de recursos (Exit 143, 137, etc)
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // 1. TRIMAGEM (Trimmomatic)
    withName: TRIM {
        module = 'trimmomatic/0.39'
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1h'
    }

    // 2. ALINHAMENTO (BWA MEM com Read Groups embutidos)
    withName: ALIGN {
        module = 'bwa/0.7.17:samtools/1.20'
        cpus   = 2
        memory = { 5.GB * task.attempt }
        time   = '12h'
    }

    // 3. PILEUP INDIVIDUAL (BCFTools)
    // Nota: Memória dinâmica. Fragmentos de regions.txt usam 8GB, Probes usam 32GB.
    withName: INDIVIDUAL_CALL {
        module = 'bcftools/1.22'
        cpus   = 2
        memory = { params.probes ? 10.GB * task.attempt : 8.GB * task.attempt }
        time   = { params.probes ? '20h' : '4h' }
    }

    // 4. JOINT CALLING (BCFTools Merge & Call)
    withName: MERGE_AND_CALL {
        module = 'bcftools/1.22'
        cpus   = 2
        memory = { 10.GB * task.attempt }
        time   = '12h'
    }

    // 5. CONTROLE DE QUALIDADE (Samtools & Mosdepth)
    withName: 'QC_BAM|COVERAGE_QC' {
        module = { task.name.contains('QC_BAM') ? 'samtools/1.20' : 'mosdepth/0.3.1' }
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    // 6. RELATÓRIO FINAL
    withName: MULTIQC {
        module = 'multiqc/1.28'
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }
}

// --- RELATÓRIOS DE EXECUÇÃO ---
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,rss,vmem'
}

report {
    enabled = true
    file    = "${params.outdir}/execution_report.html"
}

// Otimização de espaço: apaga a pasta 'work' após a conclusão com sucesso
cleanup = true
